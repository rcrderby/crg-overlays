# VS Code Development Dockerfile for CRG Overlays
# Base image
FROM ubuntu:latest

# Deno version that runs the test suite
# The `Run Tests` workflow tracks the same major version
ARG DENO_VERSION=v2.9.6

# Set the working directory
WORKDIR /workspaces/crg-overlays

# Update OS package list, install packages, and clear apt cache
RUN apt-get update && \
    apt-get install --no-install-recommends -y ca-certificates curl git ssh unzip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Deno, which runs the test suite with `deno test --allow-read tests/`
RUN case "$(uname -m)" in \
        x86_64) target='x86_64-unknown-linux-gnu' ;; \
        aarch64) target='aarch64-unknown-linux-gnu' ;; \
        *) echo "No Deno build for $(uname -m)" >&2; exit 1 ;; \
    esac && \
    curl -fsSL -o /tmp/deno.zip \
        "https://github.com/denoland/deno/releases/download/${DENO_VERSION}/deno-${target}.zip" && \
    unzip -q /tmp/deno.zip -d /usr/local/bin && \
    rm /tmp/deno.zip && \
    deno --version

# Start the bash prompt
CMD ["/bin/bash"]
